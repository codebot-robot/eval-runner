"""Set up GCP Workload Identity Federation for eval-runner on a Kubernetes cluster.

For non-GKE clusters (such as kOps on GCE or generic Kubernetes clusters) where
pods cannot access GCP metadata credentials, this task configures Workload Identity
Federation:
  1. Reads the cluster OIDC issuer and JWKS signing keys via kubectl.
  2. Ensures the GCP Workload Identity Pool exists.
  3. Creates or updates the OIDC provider with the uploaded JWKS and allowed audiences.

Every step is idempotent: re-running this script refreshes the uploaded JWKS
after cluster ServiceAccount signing-key rotations.

Only the Python standard library is used.
"""

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path
from typing import Tuple

# Ensure dev/tasks is on sys.path when invoked directly or via path
TASKS_DIRECTORY = Path(__file__).resolve().parent
if str(TASKS_DIRECTORY) not in sys.path:
    sys.path.insert(0, str(TASKS_DIRECTORY))

from task_helpers import (
    Runner,
    Step,
    project_number,
    whoami,
)

# Fixed audience allowing deployment manifests to project tokens without project or pool details.
FIXED_AUDIENCE = "eval-runner.gke-labs.dev/gcp-workload-identity"

ATTRIBUTE_MAPPING = (
    "google.subject=assertion.sub,"
    "attribute.namespace=assertion['kubernetes.io']['namespace'],"
    "attribute.service_account_name=assertion['kubernetes.io']['serviceaccount']['name']"
)

DEFAULT_PROVIDER = "kubernetes"


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--project", required=True, help="GCP project ID")
    parser.add_argument("--pool", required=True, help="Workload Identity Pool ID")
    parser.add_argument(
        "--provider",
        default=DEFAULT_PROVIDER,
        help=f"OIDC provider ID within the pool (default: {DEFAULT_PROVIDER})",
    )
    parser.add_argument("--kubeconfig", help="path to dedicated kubeconfig file (optional)")
    parser.add_argument("--dry-run", action="store_true", help="print commands without executing them")

    arguments = parser.parse_args()
    if not arguments.project.strip():
        parser.error("--project is required")

    if arguments.kubeconfig:
        arguments.kubeconfig = Path(arguments.kubeconfig).expanduser()
    return arguments


def read_cluster_oidc(runner: Runner) -> Tuple[str, str]:
    """Read and validate the cluster OIDC issuer URL and JWKS keys."""
    openid_configuration_raw = runner.output(
        ["kubectl", "get", "--raw", "/.well-known/openid-configuration"]
    )
    try:
        openid_configuration = json.loads(openid_configuration_raw)
    except json.JSONDecodeError as error:
        raise SystemExit(
            f"error: failed to parse cluster openid-configuration as JSON: {error}"
        )

    issuer_uri = openid_configuration.get("issuer")
    if not issuer_uri or not isinstance(issuer_uri, str) or not issuer_uri.startswith("https://"):
        raise SystemExit(
            f"error: cluster OIDC issuer must be an https:// URL, got {issuer_uri!r}"
        )

    jwks_raw = runner.output(["kubectl", "get", "--raw", "/openid/v1/jwks"])
    try:
        json.loads(jwks_raw)
    except json.JSONDecodeError as error:
        raise SystemExit(f"error: failed to parse cluster JWKS as JSON: {error}")

    print(f"    issuer:    {issuer_uri}")
    return issuer_uri, jwks_raw


def ensure_workload_identity_pool(runner: Runner, arguments: argparse.Namespace) -> None:
    """Describe the Workload Identity Pool, creating it if absent."""
    pool_describe_result = runner.run(
        [
            "gcloud", "iam", "workload-identity-pools", "describe", arguments.pool,
            "--location=global", f"--project={arguments.project}", "--format=json",
        ],
        check=False,
        capture=True,
        mutating=False,
    )
    if pool_describe_result.returncode == 0:
        print(f"    workload identity pool {arguments.pool} exists")
    elif "NOT_FOUND" in pool_describe_result.stderr:
        runner.run(
            [
                "gcloud", "iam", "workload-identity-pools", "create", arguments.pool,
                "--location=global", f"--project={arguments.project}",
            ],
            mutating=True,
        )
        if not arguments.dry_run:
            print(f"    created workload identity pool {arguments.pool}")
    else:
        sys.stderr.write(pool_describe_result.stderr)
        raise SystemExit(
            f"error: failed to describe workload identity pool {arguments.pool}"
        )


def ensure_oidc_provider(
    runner: Runner,
    arguments: argparse.Namespace,
    numeric_project_number: str,
    issuer_uri: str,
    jwks_raw: str,
) -> str:
    """Create or update the OIDC provider, returning the provider's default audience."""
    default_audience = (
        f"//iam.googleapis.com/projects/{numeric_project_number}/locations/global/"
        f"workloadIdentityPools/{arguments.pool}/providers/{arguments.provider}"
    )
    allowed_audiences_string = f"{default_audience},{FIXED_AUDIENCE}"

    provider_describe_result = runner.run(
        [
            "gcloud", "iam", "workload-identity-pools", "providers", "describe", arguments.provider,
            f"--workload-identity-pool={arguments.pool}", "--location=global",
            f"--project={arguments.project}", "--format=json",
        ],
        check=False,
        capture=True,
        mutating=False,
    )

    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False) as temporary_file:
        temporary_file.write(jwks_raw)
        temporary_jwks_path = temporary_file.name

    try:
        if provider_describe_result.returncode == 0:
            subcommand, action = "update-oidc", "updated"
        elif "NOT_FOUND" in provider_describe_result.stderr:
            subcommand, action = "create-oidc", "created"
        else:
            sys.stderr.write(provider_describe_result.stderr)
            raise SystemExit(
                f"error: failed to describe OIDC provider {arguments.provider}"
            )

        runner.run(
            [
                "gcloud", "iam", "workload-identity-pools", "providers", subcommand,
                arguments.provider,
                f"--workload-identity-pool={arguments.pool}",
                "--location=global",
                f"--project={arguments.project}",
                f"--issuer-uri={issuer_uri}",
                f"--jwk-json-path={temporary_jwks_path}",
                f"--attribute-mapping={ATTRIBUTE_MAPPING}",
                f"--allowed-audiences={allowed_audiences_string}",
            ],
            mutating=True,
        )
        if not arguments.dry_run:
            print(f"    {action} OIDC provider {arguments.provider}")
    finally:
        try:
            os.unlink(temporary_jwks_path)
        except OSError:
            pass

    return default_audience


def print_summary(
    arguments: argparse.Namespace,
    issuer_uri: str,
    default_audience: str,
) -> None:
    """Print a summary of the configured Workload Identity Federation resources."""
    print(f"    Pool:      {arguments.pool}")
    print(f"    Provider:  {arguments.provider}")
    print(f"    Resource:  {default_audience}")
    print(f"    Issuer:    {issuer_uri}")
    print()
    print("Next steps:")
    print("1. Grant bucket access with ./dev/tasks/setup-artifact-bucket, e.g.:")
    print(
        f"    ./dev/tasks/setup-artifact-bucket --project {arguments.project} "
        f"--bucket <bucket-name> --location <location> --workload-identity-pool {arguments.pool}"
    )
    print()
    print("2. Set gcpWorkloadIdentityProvider in eval-runner-config ConfigMap, e.g.:")
    print(f'    gcpWorkloadIdentityProvider: "{default_audience}"')


def main() -> None:
    arguments = parse_arguments()
    runner = Runner(dry_run=arguments.dry_run, kubeconfig=arguments.kubeconfig)
    if arguments.dry_run:
        print("dry run: mutating commands are printed, not executed")

    Step("Who am I")
    whoami(runner, arguments.project)
    numeric_project_number = project_number(runner, arguments.project)

    # 1. Read the issuer and JWKS from the cluster
    Step("Read cluster OIDC issuer and JWKS")
    issuer_uri, jwks_raw = read_cluster_oidc(runner)

    # 2. Pool: describe; create if absent
    Step(f"Workload Identity Pool {arguments.pool}")
    ensure_workload_identity_pool(runner, arguments)

    # 3. OIDC provider: create or update
    Step(f"OIDC provider {arguments.provider}")
    default_audience = ensure_oidc_provider(
        runner,
        arguments,
        numeric_project_number,
        issuer_uri,
        jwks_raw,
    )

    # 4. Summary
    Step("Workload Identity Federation summary")
    print_summary(arguments, issuer_uri, default_audience)


if __name__ == "__main__":
    main()
