set -o errexit
set -o nounset
set -o pipefail

export GOTOOLCHAIN=auto

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

DOCKER="${DOCKER:-docker}"
if ! command -v "${DOCKER}" >/dev/null 2>&1; then
  for d in "${HOME:-/root}/.cache/ap/tools/docker"/*/bin/docker; do
    [[ -x "${d}" ]] && DOCKER="${d}" && break
  done
fi

export PATH="${PATH}:${REPO_ROOT}/.build/bin"

TAG="$(git rev-parse --short HEAD)"
if [[ -n "$(git status --porcelain)" ]]; then
  TAG="${TAG}-dirty"
fi
export IMAGE_TAG="${IMAGE_TAG:-${TAG}}"

# Determine ap version from .ap/ap.yaml; always invoke via go run, never use a PATH binary
AP_VERSION="$(awk -F': *' '/^[[:space:]]*version:[[:space:]]*/ {gsub(/["'\'' ]/, "", $2); print $2}' "${REPO_ROOT}/.ap/ap.yaml" 2>/dev/null || true)"
AP_VERSION="${AP_VERSION:-latest}"
AP_CMD=(go run "github.com/gke-labs/gke-labs-infra/ap@${AP_VERSION}")

verify_index_has_amd64() {
  local inspect_output="$1"
  local image_name="${2:-<image>}"
  local check_py='import json, sys
def has_amd64(o):
  return (o.get("os")=="linux" and o.get("architecture")=="amd64") if isinstance(o, dict) else any(has_amd64(v) for v in (o.values() if isinstance(o, dict) else o)) if isinstance(o, (dict, list)) else False
try: sys.exit(0 if has_amd64(json.load(sys.stdin)) else 1)
except Exception: sys.exit(1)'
  if echo "${inspect_output}" | grep -q "linux/amd64" || echo "${inspect_output}" | python3 -c "${check_py}" 2>/dev/null; then
    return 0
  fi
  echo "ERROR: Pushed image index '${image_name}' does not contain 'linux/amd64' platform." >&2
  echo "Inspected platforms in index:" >&2
  echo "${inspect_output}" | grep -E "Platform:[[:space:]]*linux/|\"architecture\"|\"os\"" >&2 || true
  echo "Aborting deploy before applying manifests to prevent ImagePullBackOff on amd64 nodes." >&2
  return 1
}

detect_verification_method() {
  local image="${1:-}"
  if command -v "${DOCKER}" >/dev/null 2>&1; then
    echo "docker manifest inspect"
  elif [[ "${image}" == *"docker.pkg.dev"* ]] && command -v gcloud >/dev/null 2>&1; then
    echo "gcloud artifacts docker images describe"
  elif [[ "${image}" == *"gcr.io"* ]] && command -v gcloud >/dev/null 2>&1; then
    echo "gcloud container images describe"
  elif command -v crane >/dev/null 2>&1; then
    echo "crane manifest"
  else
    return 1
  fi
}

verify_pushed_image() {
  local image="$1"
  local method
  if ! method="$(detect_verification_method "${image}")"; then
    echo "ERROR: Failed to inspect pushed image index '${image}': no verification method available (missing docker, gcloud for Google registries, or crane)." >&2
    echo "Aborting deploy before applying manifests." >&2
    return 1
  fi
  echo "Verifying multi-platform index for ${image} contains linux/amd64..."
  local inspect_out
  case "${method}" in
    "docker manifest inspect") inspect_out="$("${DOCKER}" manifest inspect --insecure "${image}" 2>&1)" ;;
    "gcloud artifacts docker images describe") inspect_out="$(gcloud artifacts docker images describe "${image}" --format=json 2>&1)" ;;
    "gcloud container images describe") inspect_out="$(gcloud container images describe "${image}" --format=json 2>&1)" ;;
    "crane manifest") inspect_out="$(crane manifest "${image}" 2>&1)" ;;
    *) echo "ERROR: Unknown verification method: ${method}" >&2; return 1 ;;
  esac || {
    echo "ERROR: Failed to inspect pushed image index '${image}':" >&2
    echo "${inspect_out}" >&2
    echo "Aborting deploy before applying manifests." >&2
    return 1
  }
  verify_index_has_amd64 "${inspect_out}" "${image}"
}

verify_deploy_manifests_output() {
  local dry_run_output="$1"

  # 1. Guard against unauthorized in-tree k8s/ or images/ directories
  local foreign_k8s
  foreign_k8s="$(find "${REPO_ROOT}" -mindepth 2 -path "${REPO_ROOT}/.git" -prune -o -type d -name "k8s" -print 2>/dev/null || true)"
  if [[ -n "${foreign_k8s}" ]]; then
    echo "ERROR: Found unauthorized k8s directory under repository: ${foreign_k8s}" >&2
    echo "ap automatically discovers any k8s/ directory under the repository root." >&2
    echo "No directory other than ${REPO_ROOT}/k8s may be named 'k8s'." >&2
    return 1
  fi

  local foreign_images
  foreign_images="$(find "${REPO_ROOT}" -mindepth 2 -path "${REPO_ROOT}/.git" -prune -o -type d -name "images" -print 2>/dev/null || true)"
  if [[ -n "${foreign_images}" ]]; then
    echo "ERROR: Found unauthorized images directory under repository: ${foreign_images}" >&2
    echo "ap automatically discovers any images/ directory under the repository root." >&2
    echo "No directory other than ${REPO_ROOT}/images may be named 'images'." >&2
    return 1
  fi

  # 2. Reject any line mentioning a manifest path outside k8s/
  while IFS= read -r line; do
    if [[ "${line}" =~ Applying[[:space:]]+manifest[[:space:]]+([^[:space:]]+) ]]; then
      local path="${BASH_REMATCH[1]}"
      if [[ "${path}" != k8s/* && "${path}" != "${REPO_ROOT}/k8s/"* ]]; then
        echo "ERROR: Manifest path '${path}' is outside k8s/." >&2
        return 1
      fi
    fi
  done <<< "${dry_run_output}"

  # 3. Extract manifests from dry-run task tree under deploy-k8s
  local manifest_tasks=()
  while IFS= read -r line; do
    if [[ "${line}" =~ kubectl-apply-([^[:space:]]+) ]]; then
      manifest_tasks+=("${BASH_REMATCH[1]}")
    fi
  done <<< "${dry_run_output}"

  if [[ ${#manifest_tasks[@]} -eq 0 ]]; then
    echo "ERROR: ap deploy --dry-run produced no kubectl-apply tasks." >&2
    return 1
  fi

  # 4. Verify that every task corresponds to a manifest directly in this repo's k8s/ directory
  for m in "${manifest_tasks[@]}"; do
    if [[ ! -f "${REPO_ROOT}/k8s/${m}" ]]; then
      echo "ERROR: Discovered manifest '${m}' does not exist in ${REPO_ROOT}/k8s/." >&2
      echo "ap deploy must only apply manifests from this repo's k8s/ directory." >&2
      return 1
    fi
  done

  # 5. Verify that the number of tasks matches the number of manifests in k8s/
  local expected_count=0
  for f in "${REPO_ROOT}/k8s"/*.yaml "${REPO_ROOT}/k8s"/*.yml; do
    if [[ -f "${f}" ]]; then
      expected_count=$((expected_count + 1))
    fi
  done

  if [[ ${#manifest_tasks[@]} -ne ${expected_count} ]]; then
    echo "ERROR: ap deploy discovered ${#manifest_tasks[@]} manifests, but ${REPO_ROOT}/k8s/ contains ${expected_count} manifests." >&2
    echo "Discovered manifests: ${manifest_tasks[*]}" >&2
    return 1
  fi

  return 0
}

verify_deploy_manifests() {
  local dry_run_out
  if ! dry_run_out="$("${AP_CMD[@]}" deploy --dry-run 2>&1)"; then
    echo "ERROR: 'ap deploy --dry-run' failed:" >&2
    echo "${dry_run_out}" >&2
    return 1
  fi
  verify_deploy_manifests_output "${dry_run_out}"
}

run_deploy() {
  local image_prefix="${IMAGE_PREFIX:-images.local}"
  local image_repo
  if [[ "${image_prefix}" == "images.local" ]]; then
    image_repo="localhost:5000"
  else
    image_repo="${image_prefix}"
  fi

  local buildkit_host="${BUILDKIT_HOST:-}"
  local build_kubeconfig="${BUILD_KUBECONFIG:-}"
  local dry_run=false
  local skip_push=false
  local deploy_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=true
        deploy_args+=("$1")
        shift
        ;;
      --skip-push)
        skip_push=true
        deploy_args+=("$1")
        shift
        ;;
      --buildkit-host)
        buildkit_host="$2"
        shift 2
        ;;
      --buildkit-host=*)
        buildkit_host="${1#*=}"
        shift
        ;;
      --build-kubeconfig)
        build_kubeconfig="$2"
        shift 2
        ;;
      --build-kubeconfig=*)
        build_kubeconfig="${1#*=}"
        shift
        ;;
      *)
        deploy_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ -n "${buildkit_host}" ]]; then
    export BUILDKIT_HOST="${buildkit_host}"
  fi

  local build_env=()
  [[ -n "${build_kubeconfig}" ]] && build_env=(KUBECONFIG="${build_kubeconfig}")

  # Guard: always verify manifests before building, pushing, or applying
  local dry_run_out
  if ! dry_run_out="$("${AP_CMD[@]}" deploy --dry-run 2>&1)"; then
    echo "ERROR: 'ap deploy --dry-run' failed:" >&2
    echo "${dry_run_out}" >&2
    return 1
  fi
  verify_deploy_manifests_output "${dry_run_out}"

  if [[ "${dry_run}" == "true" ]]; then
    echo "${dry_run_out}"
    if [[ -n "${buildkit_host}" ]]; then
      local method
      method="$(detect_verification_method "${image_repo}/eval-runner:${IMAGE_TAG}" 2>/dev/null || echo "none (missing docker, gcloud, or crane)")"
      echo "Verification method: ${method}"
      for img_dir in images/*; do
        [[ -d "${img_dir}" ]] || continue
        echo "${build_env[*]}${build_env:+ }${AP_CMD[*]} build --push ${img_dir}"
      done
    fi
    return 0
  fi

  if [[ "${skip_push}" == "true" ]]; then
    exec "${AP_CMD[@]}" deploy "${deploy_args[@]+"${deploy_args[@]}"}"
  fi

  # 1. Build and push image index (pinned to linux/amd64 and linux/arm64 in .ap/images.yaml)
  if [[ -n "${buildkit_host}" ]]; then
    for img_dir in images/*; do
      [[ -d "${img_dir}" ]] || continue
      env "${build_env[@]}" "${AP_CMD[@]}" build --push "${img_dir}"
    done
  else
    "${AP_CMD[@]}" build --push "${deploy_args[@]+"${deploy_args[@]}"}"
  fi

  # 2. Verify that pushed index contains linux/amd64 before applying manifests
  for img_dir in images/*; do
    [[ -d "${img_dir}" ]] || continue
    local img_name
    img_name="$(basename "${img_dir}")"
    verify_pushed_image "${image_repo}/${img_name}:${IMAGE_TAG}"
  done

  # 3. Apply manifests
  if [[ -n "${build_kubeconfig}" ]]; then
    env -u BUILDKIT_HOST "${AP_CMD[@]}" deploy --skip-push "${deploy_args[@]+"${deploy_args[@]}"}"
  else
    "${AP_CMD[@]}" deploy --skip-push "${deploy_args[@]+"${deploy_args[@]}"}"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  run_deploy "$@"
fi
