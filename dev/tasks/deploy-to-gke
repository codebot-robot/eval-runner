"""Provision a GKE cluster for eval-runner and deploy to it.

This wraps the one-time cloud setup that ./dev/tasks/deploy-to-kube does not do:

  1. Fetch cluster credentials into a dedicated kubeconfig (never ~/.kube/config).
  2. Create the artifact bucket if it does not exist and grant the controller and
     UI Kubernetes ServiceAccounts access through Workload Identity Federation
     principals via ./dev/tasks/setup-artifact-bucket.
  3. Delegate generic cluster bring-up, ConfigMap, deploy, and verification
     to ./dev/tasks/deploy-to-kube.

Every step is idempotent, so re-running after fixing a permission problem is
safe. Use --dry-run to print the commands without running them.

Example:

  ./dev/tasks/deploy-to-gke \
      --cluster projects/my-project/locations/us-west1/clusters/my-cluster

Only the Python standard library is used.
"""

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

# Ensure dev/tasks is on sys.path when invoked directly or via path
TASKS_DIRECTORY = Path(__file__).resolve().parent
if str(TASKS_DIRECTORY) not in sys.path:
    sys.path.insert(0, str(TASKS_DIRECTORY))

from task_helpers import (
    Runner,
    Step,
    gcloud_json,
    whoami,
)

CLUSTER_PATH_RE = re.compile(
    r"^projects/(?P<project>[^/]+)/locations/(?P<location>[^/]+)/clusters/(?P<cluster>[^/]+)$"
)
# A zone looks like us-central1-b; the matching region is us-central1.
ZONE_RE = re.compile(r"^(?P<region>[a-z]+-[a-z]+\d+)-[a-z]$")


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__.split("Example:", 1)[1] if "Example:" in __doc__ else None,
    )
    p.add_argument(
        "--cluster",
        required=True,
        help="cluster name, or the full resource path projects/P/locations/L/clusters/C",
    )
    p.add_argument("--project", help="GCP project (required unless --cluster is a resource path)")
    p.add_argument("--location", help="cluster region or zone (required unless --cluster is a resource path)")
    p.add_argument("--bucket", help="artifact bucket name (default: <project>-eval-runner)")
    p.add_argument("--bucket-location", help="bucket location (default: the cluster's region)")
    p.add_argument("--image-prefix", help="container registry prefix (default: gcr.io/<project>)")
    p.add_argument(
        "--kubeconfig",
        help="kubeconfig file to write credentials into "
        "(default: ~/.kube/eval-runner-<project>-<cluster>.kubeconfig; never ~/.kube/config)",
    )
    p.add_argument(
        "--buildkit-host",
        default=os.environ.get("BUILDKIT_HOST"),
        help="BuildKit host to use for building images (e.g. k8s)",
    )
    p.add_argument(
        "--build-kubeconfig",
        default=os.environ.get("BUILD_KUBECONFIG"),
        help="kubeconfig for the build cluster running BuildKit",
    )
    p.add_argument(
        "--set",
        action="append",
        default=[],
        metavar="KEY=VALUE",
        help="extra eval-runner-config ConfigMap entries, e.g. --set sandboxdImage=gcr.io/p/sandboxd:tag "
        "(repeatable)",
    )
    p.add_argument(
        "--skip-sandboxd-build",
        action="store_true",
        help="reuse an already pushed sandboxd image",
    )
    p.add_argument("--skip-deploy", action="store_true", help="provision only; do not run ./dev/tasks/deploy")
    p.add_argument("--skip-bucket", action="store_true", help="do not create the bucket or grant access to it")
    p.add_argument(
        "--restart",
        action="store_true",
        help="restart deployments after deploying (for clusters running a controller older than #277)",
    )
    p.add_argument("--dry-run", action="store_true", help="print the commands that would run")
    args = p.parse_args()

    m = CLUSTER_PATH_RE.match(args.cluster)
    if m:
        for key in ("project", "location", "cluster"):
            if getattr(args, key) not in (None, args.cluster) and getattr(args, key) != m.group(key):
                p.error(f"--{key} conflicts with the value in --cluster")
        args.project, args.location, args.cluster = m.group("project"), m.group("location"), m.group("cluster")
    if not args.project or not args.location:
        p.error("--project and --location are required unless --cluster is a full resource path")

    args.bucket = args.bucket or f"{args.project}-eval-runner"
    args.bucket = args.bucket.removeprefix("gs://").rstrip("/")
    if not args.bucket_location:
        zm = ZONE_RE.match(args.location)
        args.bucket_location = zm.group("region") if zm else args.location
    args.image_prefix = args.image_prefix or f"gcr.io/{args.project}"
    args.kubeconfig = Path(
        args.kubeconfig or Path.home() / ".kube" / f"eval-runner-{args.project}-{args.cluster}.kubeconfig"
    ).expanduser()
    for item in args.set:
        if "=" not in item:
            p.error(f"--set expects KEY=VALUE, got {item!r}")
    return args


def repo_root() -> Path:
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
    return Path(out.stdout.strip())


def ensure_kubeconfig(r: Runner, args: argparse.Namespace) -> None:
    args.kubeconfig.parent.mkdir(parents=True, exist_ok=True)
    r.run(
        [
            "gcloud", "container", "clusters", "get-credentials", args.cluster,
            f"--location={args.location}", f"--project={args.project}",
        ]
    )
    print(f"    kubeconfig: {args.kubeconfig}")
    print(f"    use it with: export KUBECONFIG={args.kubeconfig}")


def workload_identity_pool(r: Runner, args: argparse.Namespace) -> str:
    info = gcloud_json(
        r,
        [
            "gcloud", "container", "clusters", "describe", args.cluster,
            f"--location={args.location}", f"--project={args.project}",
        ],
    ) or {}
    pool = (info.get("workloadIdentityConfig") or {}).get("workloadPool", "")
    if not pool:
        raise SystemExit(
            f"error: cluster {args.cluster} has no Workload Identity pool. Enable it with\n"
            f"  gcloud container clusters update {args.cluster} --location={args.location} "
            f"--project={args.project} --workload-pool={args.project}.svc.id.goog\n"
            "or pass --skip-bucket to deploy without artifact storage."
        )
    return pool


def main() -> None:
    args = parse_args()
    root = repo_root()
    r = Runner(args.dry_run, args.kubeconfig)
    if args.dry_run:
        print("dry run: mutating commands are printed, not executed")

    Step("Who am I")
    whoami(r, args.project)

    Step(f"Cluster credentials for {args.cluster} ({args.location})")
    ensure_kubeconfig(r, args)

    if args.skip_bucket:
        Step("Artifact bucket (skipped)")
        print("    --skip-bucket: sample trajectories will not be viewable in the UI")
    else:
        Step(f"Artifact bucket gs://{args.bucket}")
        pool = workload_identity_pool(r, args)
        setup_artifact_bucket_command = [
            str(root / "dev" / "tasks" / "setup-artifact-bucket"),
            f"--project={args.project}",
            f"--bucket={args.bucket}",
            f"--location={args.bucket_location}",
            f"--workload-identity-pool={pool}",
        ]
        if args.dry_run:
            setup_artifact_bucket_command.append("--dry-run")
        r.run(setup_artifact_bucket_command, mutating=False)

    Step("Deploying eval-runner via deploy-to-kube")
    cmd = [
        str(root / "dev" / "tasks" / "deploy-to-kube"),
        f"--image-prefix={args.image_prefix}",
    ]
    if not args.skip_bucket:
        cmd.extend(["--set", f"artifactBucket={args.bucket}", "--set", "artifactDir=none"])
    for item in args.set:
        cmd.extend(["--set", item])
    if args.buildkit_host:
        cmd.append(f"--buildkit-host={args.buildkit_host}")
    if args.build_kubeconfig:
        cmd.append(f"--build-kubeconfig={args.build_kubeconfig}")
    if args.skip_sandboxd_build:
        cmd.append("--skip-sandboxd-build")
    if args.skip_deploy:
        cmd.append("--skip-deploy")
    if args.restart:
        cmd.append("--restart")
    if args.dry_run:
        cmd.append("--dry-run")

    r.run(cmd, mutating=False)

    Step("GKE deployment complete")
    print(f"    export KUBECONFIG={args.kubeconfig}")


if __name__ == "__main__":
    main()
