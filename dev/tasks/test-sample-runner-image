set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

export PATH="${REPO_ROOT}/.build/bin:${PATH}"

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    echo "Docker is not available; skipping sample-runner image test."
    exit 0
fi

echo "=== Building sample-runner image ==="
docker build -t sample-runner-test:latest -f images/sample-runner/Dockerfile images/sample-runner

echo "=== Verifying provider deps import ==="
docker run --rm sample-runner-test:latest python -c "import google.genai, openai, anthropic"

echo "=== Verifying inspect eval --help ==="
docker run --rm sample-runner-test:latest inspect eval --help >/dev/null

echo "=== sample-runner image smoke test passed successfully ==="
