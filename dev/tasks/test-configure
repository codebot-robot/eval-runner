"""Unit and CLI tests for dev/tasks/configure."""

import importlib.machinery
import importlib.util
import json
import os
import stat
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

TASKS_DIRECTORY = Path(__file__).resolve().parent
CONFIGURE_SCRIPT = TASKS_DIRECTORY / "configure"


def load_configure_module():
    loader = importlib.machinery.SourceFileLoader("configure_task", str(CONFIGURE_SCRIPT))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


configure = load_configure_module()

FAKE_KUBECTL = """#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
log_path = Path(os.environ["FAKE_KUBECTL_LOG"])
with log_path.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(args) + chr(10))

if args[:2] == ["config", "current-context"]:
    context = os.environ.get("FAKE_KUBECTL_CONTEXT", "")
    if not context:
        sys.stderr.write("error: current-context is not set" + chr(10))
        sys.exit(1)
    print(context)
    sys.exit(0)

if len(args) >= 5 and args[2:4] == ["get", "configmap"]:
    state_path = Path(os.environ["FAKE_KUBECTL_STATE"])
    if not state_path.exists():
        sys.stderr.write('Error from server (NotFound): configmaps "eval-runner-config" not found' + chr(10))
        sys.exit(1)
    print(state_path.read_text(encoding="utf-8"))
    sys.exit(0)

if len(args) >= 5 and args[2:4] == ["get", "deployment"]:
    deployment = args[4]
    existing = set(filter(None, os.environ.get("FAKE_KUBECTL_DEPLOYMENTS", "").split(",")))
    if deployment in existing:
        print(f"deployment.apps/{deployment}")
        sys.exit(0)
    sys.stderr.write(f'Error from server (NotFound): deployments.apps "{deployment}" not found' + chr(10))
    sys.exit(1)

if args[:2] == ["apply", "-f"]:
    payload = sys.stdin.read()
    Path(os.environ["FAKE_KUBECTL_STATE"]).write_text(payload, encoding="utf-8")
    print("configmap/eval-runner-config configured")
    sys.exit(0)

if len(args) >= 4 and args[2] == "rollout":
    print("ok")
    sys.exit(0)

sys.stderr.write(f"unexpected kubectl args: {args}" + chr(10))
sys.exit(2)
"""


class MergeAndRestartUnitTests(unittest.TestCase):
    def test_merge_preserves_existing_and_applies_ordered_operations(self):
        existing = {
            "artifactBucket": "existing-bucket",
            "servicePortalControllerAddress": "custom:8443",
            "oldKey": "remove-me",
        }
        merged, updated, removed = configure.merge_config_data(
            existing,
            [
                ("set_default", "servicePortalControllerAddress=default:8443"),
                ("set_default", "servicePortalTokenFile=/var/run/token"),
                ("unset", "oldKey"),
                ("unset", "missingKey"),
                ("set", "defaultModel=google/gemini-2.5-flash"),
                ("set", "sandboxdImage=img:v1"),
                ("set", "sandboxdImage=img:v2"),
            ],
        )
        self.assertEqual(
            merged,
            {
                "artifactBucket": "existing-bucket",
                "servicePortalControllerAddress": "custom:8443",
                "servicePortalTokenFile": "/var/run/token",
                "defaultModel": "google/gemini-2.5-flash",
                "sandboxdImage": "img:v2",
            },
        )
        self.assertEqual(updated, ["defaultModel", "sandboxdImage", "servicePortalTokenFile"])
        self.assertEqual(removed, ["oldKey"])

    def test_merge_noop_when_unchanged(self):
        existing = {"defaultModel": "mockllm/model", "maxParallelTasks": "4"}
        merged, updated, removed = configure.merge_config_data(
            existing,
            [("set", "defaultModel=mockllm/model"), ("unset", "absentKey")],
        )
        self.assertEqual(merged, existing)
        self.assertEqual(updated, [])
        self.assertEqual(removed, [])

    def test_deployments_needing_restart(self):
        self.assertEqual(
            configure.deployments_needing_restart(["maxParallelTasks", "uiBaseURL"]),
            {},
        )
        self.assertEqual(
            configure.deployments_needing_restart(["servicePortalControllerAddress", "uiBaseURL"]),
            {"eval-runner-controller": ["servicePortalControllerAddress"]},
        )
        self.assertEqual(
            configure.deployments_needing_restart(
                ["gcpProjectParentFolderID", "gcpProjectBillingAccountID"]
            ),
            {
                "eval-runner-controller": [
                    "gcpProjectBillingAccountID",
                    "gcpProjectParentFolderID",
                ]
            },
        )
        self.assertEqual(
            configure.deployments_needing_restart(
                ["defaultModel", "webhookRepositories", "servicePortalTokenFile"]
            ),
            {
                "eval-runner-controller": ["servicePortalTokenFile"],
                "eval-runner-webhook": ["defaultModel", "webhookRepositories"],
            },
        )


class ConfigureCLITests(unittest.TestCase):
    def setUp(self):
        self.temp_dir = tempfile.TemporaryDirectory()
        self.root = Path(self.temp_dir.name)
        self.kubectl_path = self.root / "kubectl"
        self.kubectl_path.write_text(FAKE_KUBECTL, encoding="utf-8")
        self.kubectl_path.chmod(self.kubectl_path.stat().st_mode | stat.S_IXUSR)
        self.log_path = self.root / "kubectl.log"
        self.state_path = self.root / "configmap.json"

    def tearDown(self):
        self.temp_dir.cleanup()

    def write_state(self, data):
        manifest = {
            "apiVersion": "v1",
            "kind": "ConfigMap",
            "metadata": {"name": "eval-runner-config", "namespace": "eval-runner"},
            "data": data,
        }
        self.state_path.write_text(json.dumps(manifest), encoding="utf-8")

    def read_state_data(self):
        return json.loads(self.state_path.read_text(encoding="utf-8"))["data"]

    def read_calls(self):
        if not self.log_path.exists():
            return []
        return [json.loads(line) for line in self.log_path.read_text(encoding="utf-8").splitlines() if line]

    def run_configure(self, args, context="kind-test", deployments="eval-runner-controller,eval-runner-webhook"):
        if self.log_path.exists():
            self.log_path.unlink()
        env = os.environ.copy()
        env["PATH"] = f"{self.root}:{env.get('PATH', '')}"
        env["FAKE_KUBECTL_LOG"] = str(self.log_path)
        env["FAKE_KUBECTL_STATE"] = str(self.state_path)
        env["FAKE_KUBECTL_CONTEXT"] = context
        env["FAKE_KUBECTL_DEPLOYMENTS"] = deployments
        return subprocess.run(
            [sys.executable, str(CONFIGURE_SCRIPT), *args],
            env=env,
            text=True,
            capture_output=True,
            check=False,
        )

    def test_merge_hot_reloaded_key_does_not_restart(self):
        self.write_state({"artifactBucket": "bucket-a"})
        result = self.run_configure(["--set", "maxParallelTasks=8"])
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("context: kind-test", result.stdout)
        self.assertIn("updated: maxParallelTasks=8", result.stdout)
        self.assertIn("no deployment restart required", result.stdout)
        self.assertEqual(
            self.read_state_data(),
            {"artifactBucket": "bucket-a", "maxParallelTasks": "8"},
        )
        calls = self.read_calls()
        self.assertTrue(any(call[:2] == ["apply", "-f"] for call in calls))
        self.assertFalse(any("rollout" in call for call in calls))

    def test_noop_when_unchanged(self):
        self.write_state({"defaultModel": "google/gemini-2.5-flash"})
        result = self.run_configure(["--set", "defaultModel=google/gemini-2.5-flash"])
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("already up to date", result.stdout)
        calls = self.read_calls()
        self.assertFalse(any(call[:2] == ["apply", "-f"] for call in calls))
        self.assertFalse(any("rollout" in call for call in calls))

    def test_restart_only_webhook_key_restarts_webhook_only(self):
        self.write_state({"artifactBucket": "bucket-a"})
        result = self.run_configure(["--set", "defaultModel=google/gemini-2.5-flash"])
        self.assertEqual(result.returncode, 0, result.stderr)
        calls = self.read_calls()
        self.assertIn(
            ["-n", "eval-runner", "rollout", "restart", "deployment/eval-runner-webhook"],
            calls,
        )
        self.assertNotIn(
            ["-n", "eval-runner", "rollout", "restart", "deployment/eval-runner-controller"],
            calls,
        )

    def test_restart_only_controller_key_restarts_controller_only(self):
        self.write_state({"artifactBucket": "bucket-a"})
        result = self.run_configure(["--set", "servicePortalControllerAddress=sp.local:8443"])
        self.assertEqual(result.returncode, 0, result.stderr)
        calls = self.read_calls()
        self.assertIn(
            ["-n", "eval-runner", "rollout", "restart", "deployment/eval-runner-controller"],
            calls,
        )
        self.assertNotIn(
            ["-n", "eval-runner", "rollout", "restart", "deployment/eval-runner-webhook"],
            calls,
        )

    def test_gcp_project_folder_and_billing_restart_controller_only(self):
        self.write_state({"artifactBucket": "bucket-a"})
        result = self.run_configure(
            [
                "--set",
                "gcpProjectParentFolderID=123456789012",
                "--set",
                "gcpProjectBillingAccountID=012345-6789AB-CDEF01",
            ]
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(
            self.read_state_data(),
            {
                "artifactBucket": "bucket-a",
                "gcpProjectParentFolderID": "123456789012",
                "gcpProjectBillingAccountID": "012345-6789AB-CDEF01",
            },
        )
        calls = self.read_calls()
        self.assertIn(
            ["-n", "eval-runner", "rollout", "restart", "deployment/eval-runner-controller"],
            calls,
        )
        self.assertNotIn(
            ["-n", "eval-runner", "rollout", "restart", "deployment/eval-runner-webhook"],
            calls,
        )

    def test_gcp_project_pool_restarts_controller_only(self):
        self.write_state({"artifactBucket": "bucket-a"})
        result = self.run_configure(["--set", "gcpProjectPool=pool-a,pool-b"])
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(
            self.read_state_data(),
            {
                "artifactBucket": "bucket-a",
                "gcpProjectPool": "pool-a,pool-b",
            },
        )
        calls = self.read_calls()
        self.assertIn(
            ["-n", "eval-runner", "rollout", "restart", "deployment/eval-runner-controller"],
            calls,
        )
        self.assertNotIn(
            ["-n", "eval-runner", "rollout", "restart", "deployment/eval-runner-webhook"],
            calls,
        )

    def test_no_restart_flag_skips_rollout_and_prints_requirement(self):
        self.write_state({})
        result = self.run_configure(["--no-restart", "--set", "defaultModel=mockllm/model"])
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("restart required: eval-runner-webhook", result.stdout)
        self.assertFalse(any("rollout" in call for call in self.read_calls()))

    def test_dry_run_makes_no_mutations(self):
        self.write_state({"artifactBucket": "bucket-a"})
        result = self.run_configure(["--dry-run", "--set", "defaultModel=google/gemini-2.5-flash"])
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("kubectl apply -f -", result.stdout)
        self.assertIn("rollout restart deployment/eval-runner-webhook", result.stdout)
        self.assertEqual(self.read_state_data(), {"artifactBucket": "bucket-a"})
        calls = self.read_calls()
        self.assertFalse(any(call[:2] == ["apply", "-f"] for call in calls))
        self.assertFalse(any("rollout" in call for call in calls))

    def test_missing_context_fails_before_mutating(self):
        result = self.run_configure(["--set", "maxParallelTasks=8"], context="")
        self.assertNotEqual(result.returncode, 0)
        self.assertIn("no active kubectl context", result.stderr)
        self.assertFalse(self.state_path.exists())


if __name__ == "__main__":
    unittest.main(verbosity=2)
